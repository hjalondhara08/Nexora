# Groq API Key (Required for LLM Orchestrator)
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key (Required for Dense Embeddings & Reranking)
COHERE_API_KEY=your_cohere_api_key_here

# Tavily API Key (Optional for Tavily Web Search)
TAVILY_API_KEY=your_tavily_api_key_here

# Hugging Face Token (Optional)
HF_TOKEN=your_huggingface_token_here

# Qdrant Vector DB URL (Default: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# LangSmith Tracing (Optional for Monitoring)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Nexora_AI_Agent
